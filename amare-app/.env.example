# AMARÉ mobile app — local dev
# Copy to .env

# Backend (amare-site `npm run dev` on port 4321)
VITE_API_BASE=http://127.0.0.1:4321

# Public HTTPS URL for OAuth start (ngrok → 4321). Required for Mindbody sign-in.
# Example: https://abc123.ngrok-free.app
# VITE_OAUTH_API_BASE=https://abc123.ngrok-free.app

# Pricing page (opens in browser for "Buy a pass")
VITE_PRICING_URL=http://127.0.0.1:4321/pricing
