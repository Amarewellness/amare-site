# Mindbody Public API (see Developer Portal API Credentials).
# Copy to ".env" and fill in real values — never commit .env.

# Issued under "API Keys" — sent as HTTP header: API-Key
MINDBODY_API_KEY=

# Sandbox studio is typically -99. Your real membership data lives under your live Site ID —
# OAuth can succeed while `/member` stays empty until MINDBODY_SITE_ID matches that studio (-99 often has no prod clients).
# For consumer requests (`consumer-identity-token`), the Functions send MINDBODY_SITE_ID as `SiteId` when it is set and not -99.
MINDBODY_SITE_ID=-99

# Numeric studio id in Mindbody Classic URLs (`clients.mindbodyonline.com/classic/ws?studioid=`).
# `/pricing` reads this at build time; omit to keep build default matching production pricing links.
MINDBODY_CLASSIC_STUDIO_ID=

# `/pricing` — prodid whitelist for memberships that use Mindbody Classic stype=40 (recurring/monthly).
# Default baked into build: 100,101,102 (`pricing.html`). Override with comma list, or `none` for name-only routing.
# MINDBODY_CONTRACT_PRODUCT_IDS=100,101,102
# MINDBODY_SALE_LOCATION_ID=1
# When set to 1/true, `/pricing` will not embed static monthly fallback (only live GET /sale/contracts).
# MINDBODY_DISABLE_MONTHLY_CONTRACT_FALLBACK=1

# Allow real card charges from POST /api/mindbody/sale/checkout when set to exactly 1. Default UX is Mindbody Test (dry-run) until the user confirms a live charge.
# MINDBODY_ALLOW_LIVE_PRICING_CHECKOUT=

# Checkout (`POST …/sale/checkoutshoppingcart`): staff User Token as Authorization Bearer — Consumer OAuth alone is denied.
#
# Recommended (production): dedicated integration staff username/password → server issues a User Token (cached in-memory on warm Netlify instances; `POST /api/mindbody/sale/checkout-warmup` prefetches after sign-in on `/pricing`).
# Same staff token is used for `POST /api/mindbody/client/register` (Add Client on `/classes` sign-up modal) when unified dev or Netlify serve that route.
MINDBODY_STAFF_USERNAME=
MINDBODY_STAFF_PASSWORD=
#
# Disable public profile signup (`POST /api/mindbody/client/register`).
# MINDBODY_DISABLE_CLIENT_SIGNUP=1
#
# Optional; timeout (ms, clamped) for AddClient during signup registration.
# MINDBODY_ADD_CLIENT_TIMEOUT_MS=20000
#
# Optional tuning (ms / sec) — see `mindbody-consumer-lib.mjs` for clamps.
# MINDBODY_ISSUE_TOKEN_TIMEOUT_MS=8000
# MINDBODY_CHECKOUT_TIMEOUT_MS=20000
# If issued token is not a JWT with `exp`, fall back cache TTL (seconds, 60–86400).
# MINDBODY_STAFF_TOKEN_CACHE_TTL_SEC=300
#
# Legacy: paste AccessToken from Issue once — expires.
# MINDBODY_STAFF_USER_TOKEN=

# When set to exactly 1, POST /api/mindbody/sale/checkout records each `purchaseAttemptId` in Netlify Blobs (replay-safe duplicates, 409 while pending). Requires Blobs on the site and a function invocation with `event.blobs`.
# MINDBODY_CHECKOUT_IDEMPOTENCY_BLOBS=

# When set to 1/true, recurring membership checkout stores a structured electronic-consent audit (snapshot HTML hash + typed name + checkboxes + IP/UA + Mindbody IDs) to Netlify Blobs (`mindbody-membership-consents`). Recommended for production if you rely on `/pricing` embedded checkout — requires Blob storage on Functions.
# MINDBODY_MEMBERSHIP_CONSENT_BLOBS=

# Public API Source (same Credentials page).
# Needed for authenticated flows (e.g. staff tokens). Optional for anonymous checks.
MINDBODY_SOURCE_NAME=
MINDBODY_SOURCE_PASSWORD=

# Default production host per docs; override only if Mindbody directs you elsewhere.
MINDBODY_API_HOST=api.mindbodyonline.com

# Mindbody GET proxy (`npm run mindbody:proxy`) — optional if you already use unified `npm run dev`.
# This port serves ONLY /health and GET /api/mindbody/* — no HTML, no /css. Do not point ngrok here for full pages.
MINDBODY_LOCAL_PORT=8787

# Optional: overrides where the browser calls `/api/mindbody/class/classes`, OAuth, member summary, booking.
# Leave EMPTY when using unified local dev (`npm run dev`): same-origin `/api/mindbody/...` → no Netlify, no extra port.
# Production (Netlify): set to your public site URL, e.g. https://www.amarewellness.com — then redeploy so `data-mb-proxy` embeds correctly.
#
# Separate proxy only (`npm run dev:static` + `npm run mindbody:proxy`): http://127.0.0.1:8787 — note OAuth/booking APIs are NOT on 8787; use unified `npm run dev` instead.
#
# Tunneling (ngrok, Cloudflare, etc.) for OAuth: forward to unified dev (`npm run dev`) on LOCAL_FULL_DEV_PORT (default 4321),
# NOT to MINDBODY_LOCAL_PORT (8787). Otherwise `/pricing` HTML may appear from cache while `/css/*.css` hits a server that returns 404.
#
# LOCAL_FULL_DEV_HOST=0.0.0.0
# LOCAL_FULL_DEV_PORT=4321
SCHEDULE_PROXY_BASE=

# Optional: per-class "Book" link template (HTTPS URL). Substitutions below.
# Booking via API normally uses POST …/class/addclienttoclass with a client JWT — Mindbody docs.
# Alternative: branded booking URL patterns from Mindbody support / custom-online-booking-links.
# Placeholders:
# {siteId} {classId} {classScheduleId} {locationId} {startDateEt} yyyy-mm-dd ET {startISO} URL-encoded
MINDBODY_BOOK_URL_TEMPLATE=

# When template is empty, Book opens this page relative to site root (widget).
MINDBODY_BOOK_FALLBACK_REL=classes.html

# Optional: “New client / Sign up” link in Book modal (HTTPS). When empty, the modal uses MINDBODY_BOOK_FALLBACK_REL (Mindbody widget) for onboarding.
MINDBODY_CONSUMER_SIGNUP_URL=

# ─── OPTIONAL: OAuth "consumer / web app" flow (sign-in UX on /classes).
# Mindbody Public API tutorials that use API-Key/Source do NOT grant these IDs.
# Omit this whole block if you only use the schedule proxy + MINDBODY_API_KEY.
# When needed: Mindbody Developer Portal → create/register a separate OAuth / Web application
# for your site; CLIENT_ID & CLIENT_SECRET come from that app — not from the API Credentials screen.
# Redirect URI MUST match the Mindbody client exactly — same scheme, host, port, path, no trailing slash.
# Mindbody’s portal rejects typical local URLs (http://127.0.0.1 / http://localhost). You get signin „invalid-parameters”.
# Practical options:
#   • HTTPS production or Netlify Deploy Preview URL + path /api/mindbody/oauth/callback
#   • HTTPS tunnel to this machine (ngrok / cloudflared): register the tunnel https://…/api/mindbody/oauth/callback
#     then open the site ONLY via that same https://… URL (cookie is scoped to that host, not http://127.0.0.1).
MINDBODY_OAUTH_CLIENT_ID=
MINDBODY_OAUTH_CLIENT_SECRET=
MINDBODY_OAUTH_REDIRECT_URI=https://www.example.com/api/mindbody/oauth/callback
MINDBODY_OAUTH_ISSUER=https://signin.mindbodyonline.com
MINDBODY_OAUTH_SCOPES=email profile openid offline_access Mindbody.Api.Public.v6
# Optional; sent to authorize + token if your OAuth app uses a fixed subscriber (often same as site / from Mindbody support).
# MINDBODY_OAUTH_SUBSCRIBER_ID=
#
# Random secret (≥24 chars); only used when OAuth sign-in is enabled — seals the HttpOnly mb_sess cookie on the server.
# Unified `npm run dev` exits on startup if this is empty (OAuth/member routes need it).
MINDBODY_SESSION_SECRET=

# ── Mobile app (Phase 0) — Bearer auth for Capacitor app. Default OFF — web uses mb_sess cookie only.
# ENABLE_MOBILE_BEARER_AUTH=0
# Optional override for mobile OAuth redirect. When unset, mobile uses MINDBODY_OAUTH_REDIRECT_URI
# (same URL already registered on your Mindbody Web client — no extra portal entry needed for local dev).
# MINDBODY_OAUTH_MOBILE_REDIRECT_URI=https://YOUR-TUNNEL.ngrok-free.app/api/mindbody/oauth/mobile-bridge
# Production native deep link (requires new URI at OAuth client creation): amare://oauth/callback
# Optional dedicated JWT secret; falls back to MINDBODY_SESSION_SECRET when unset.
# MOBILE_JWT_SECRET=
# MOBILE_JWT_ACCESS_TTL_SECONDS=3600
# MOBILE_JWT_REFRESH_TTL_SECONDS=2592000

# ─────────────────────────────────────────────────────────────────────────────
# Mindbody Webhooks (PR-2A) — invalidate CDN tag `mindbody-schedule` on schedule changes.
# No portal UI: create subscription via Push API (POST …/subscriptions), then PATCH Active.
# Webhook URL: https://www.amarewellness.com/api/mindbody/webhooks/schedule
# Events: class.updated, classSchedule.created|updated|cancelled, classDescription.updated
# Copy `messageSignatureKey` (NOT the API-Key) into MINDBODY_WEBHOOK_SIGNATURE_KEY on Netlify.
# Full ops steps: docs/MINDBODY.md § PR-2A
# API docs: https://developers.mindbodyonline.com/ui/documentation/webhooks-api
MINDBODY_WEBHOOK_SIGNATURE_KEY=
# Local dev only — never set in production (skips HMAC verify when testing without Mindbody POST).
# MINDBODY_WEBHOOK_SKIP_VERIFY=1
# Dedupe by messageId via Netlify Blobs (default on Netlify; set 0 to disable).
# MINDBODY_WEBHOOK_DEDUPE_BLOBS=1

# ─────────────────────────────────────────────────────────────────────────────
# Stripe → Mindbody one-time checkout (NCS / drop-in / 5–10–20 class packs).
# Recurring memberships are NOT routed through Stripe — they stay on Mindbody classic.
# Catalog mapping lives in `netlify/functions/_embedded/stripe-mindbody-catalog.config.json`.
# Flow + decisions: `docs/STRIPE-MINDBODY-QUESTIONS.md`.

# Master kill-switch. When `1`, `/api/stripe/checkout/create-session` accepts requests and
# the express-checkout CTA renders on /pricing for SKUs flagged `enabledForExpressCheckout`.
# Default `0` so existing Mindbody classic flow is unchanged until you flip this.
ENABLE_STRIPE_ONE_TIME_CHECKOUT=0

# Stripe API keys. Use the test keys (`sk_test_…` / `pk_test_…`) until production rollout.
# Never expose `STRIPE_SECRET_KEY` to the browser; only `STRIPE_PUBLISHABLE_KEY` is safe to embed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Stable Stripe Product id for `drop_in_single_class` one-time Checkout only.
# Required when that SKU is purchased: create-session fails with
# `stripe_dropin_product_id_missing` if unset/invalid (no silent fallback to product_data).
# Other SKUs (including drop_in_same_day, NCS, packs, memberships) ignore this var and keep
# inline product_data. Create the Product in Stripe Test (and later Live) without a fixed
# Price — Checkout still sends dynamic unit_amount. Use this Product id in Coupon
# applies_to.products so a Promotion Code can be Drop-In Single Class only.
# Example: STRIPE_DROPIN_SINGLE_PRODUCT_ID=prod_XXXXXXXX
# STRIPE_DROPIN_SINGLE_PRODUCT_ID=

# Webhook signing secret from your Stripe Dashboard → Developers → Webhooks endpoint.
# `stripe-webhook.mjs` rejects requests whose signature does not verify under this secret.
STRIPE_WEBHOOK_SECRET=

# Optional return URLs override (defaults are derived from the request `origin`).
# STRIPE_SUCCESS_URL=https://www.amarewellness.com/checkout/success?session_id={CHECKOUT_SESSION_ID}&orderId={ORDER_ID}
# STRIPE_CANCEL_URL=https://www.amarewellness.com/checkout/cancel?orderId={ORDER_ID}

# How the post-Stripe Mindbody sync books the sale.
#  • `custom`  — recommended. Use the Mindbody Payment Method named in MINDBODY_STRIPE_PAYMENT_METHOD_NAME (default "Stripe").
#                Requires that payment method to exist + Allow >$0 + PayNotes enabled.
#  • `comp`    — fallback / dev only. Books the line as `Comp` ($0) with notes referencing the Stripe order.
#                Will under-report Mindbody revenue; do not use in production unless you accept that.
# If `custom` is selected and Mindbody rejects the payment method on a live sync, the order is parked at
# `paid_but_not_synced` for manual review — we do NOT silently downgrade to comp.
MINDBODY_STRIPE_PAYMENT_MODE=custom

# Display name of the custom Mindbody Payment Method. Match exactly what was created in Mindbody
# (Site Settings → Payment Methods). Default: `Stripe`.
MINDBODY_STRIPE_PAYMENT_METHOD_NAME=Stripe

# Numeric Mindbody Payment Method id for the custom `Stripe` row.
# REQUIRED when MINDBODY_STRIPE_PAYMENT_MODE=custom — Mindbody rejects `Type:"Custom"` Payments
# without `Metadata.id` ("The received Custom's Metadata was missing key id.").
# Discover with: `npm run stripe:find-mb-payment-id`
# (calls GET /public/v6/sale/custompaymentmethods and prints id+name pairs).
MINDBODY_STRIPE_PAYMENT_METHOD_ID=

# Optional: protected token for `/api/stripe/admin/orders` (list / retry / mark resolved).
# Generate with `openssl rand -hex 24`. Endpoint requires header `x-admin-token: <value>`.
# ADMIN_DEBUG_TOKEN=

# Site URL fallback used by `/api/stripe/checkout/create-session` to build success/cancel URLs
# when the inbound request does not provide an `origin`. Optional.
# SITE_URL=https://www.amarewellness.com

# Analytics tags — injected at build time by scripts/build.mjs (requires Netlify build, not Drop-only deploy).
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
# META_PIXEL_ID=1234567890123456
# OpenAI Ads Measurement Pixel (ChatGPT Ads). Create the Pixel ID in OpenAI Ads Manager → Conversions.
# OPENAI_PIXEL_ID=
# OPENAI_PIXEL_DEBUG=false

# LOCAL DEV ONLY: in-memory order store fallback for `npm run dev` (no Netlify Blobs context).
# Set to `1` only on a developer machine. Hard-disabled when `NETLIFY` env var is present, so it
# can never activate in a real Netlify deploy. Order data lives in the dev process memory and is
# lost on restart. Real deploys must use Netlify Blobs.
# STRIPE_ORDER_STORE_LOCAL_MEMORY=1

# SAFETY GATE between Stripe test mode and the Mindbody sync.
#
# Stripe `event.livemode === false` (test card / test secret key) → behavior depends on this var.
# Stripe `event.livemode === true`  (live card)                    → ALWAYS syncs to Mindbody live, regardless of this var.
#
# Allowed values:
#  • `skip`           — DEFAULT. Stripe test events never touch Mindbody. The order is recorded
#                       with status `test_mode_no_sync` for accounting. Stripe gets 200 so it
#                       stops retrying. Use this in production: a leaked test card cannot create
#                       a real Mindbody client or service.
#  • `mindbody_test`  — Pipeline rehearsal. Webhook still calls Mindbody, but with the Mindbody
#                       `Test: true` flag — Mindbody validates the request without persisting a
#                       real client / service. Useful for dev / staging to exercise the full sync
#                       path end-to-end.
#  • `live`           — DANGEROUS. Stripe test events are synced to Mindbody as if they were
#                       live. Do not use against your production Mindbody site. Acceptable only
#                       for staging environments pointing at a sandbox Mindbody site (-99) where
#                       you want to see real records get created.
#
# Default if unset: `skip`.
# STRIPE_TEST_MODE_MINDBODY_BEHAVIOR=skip

# Stripe Checkout — Contact information prefill from Mindbody (logged-in members).
#
# When ON, `stripe-create-checkout-session.mjs` looks up the buyer's Mindbody profile
# (clientId by email if needed → email/name/phone) and binds it to a Stripe Customer so
# Stripe-hosted Checkout shows their email/name/phone already filled in. Adds 1–2 extra
# Mindbody round-trips + 1–2 Stripe API calls before the redirect (each capped by
# `STRIPE_CHECKOUT_PREFILL_TIMEOUT_MS`).
#
# Anonymous buyers are unaffected (no extra calls).
#
# Set to 0 to disable WITHOUT a redeploy if Mindbody latency hurts checkout. Anonymous
# fallback still works — checkout never blocks, members just have to retype.
#
# Accepted values: 1 / true / on (default)  |  0 / false / off (kill-switch).
# STRIPE_CHECKOUT_PREFILL_FROM_MINDBODY=1

# Hard timeout (ms) per Mindbody call inside the prefill flow above. If Mindbody is slower
# than this for clientId-by-email or contact lookup, we silently fall back to anonymous
# checkout (the customer never waits longer than this for prefill).
#
# Bounded between 2000 and 10000. Default 5000.
# STRIPE_CHECKOUT_PREFILL_TIMEOUT_MS=5000

# ============================================================================
# Auto-merge duplicate Studio Clients on OAuth callback (anonymous-purchase fix)
# ============================================================================
#
# Problem this solves:
#   Anonymous Stripe purchase flow:
#     1. addclient API → Studio Client A (with package), no Mindbody Identity link.
#     2. User clicks "Sign in & book a class" in Welcome email → OAuth Identity flow.
#     3. Mindbody Identity creates Studio Client B (Identity-linked, empty).
#     4. ⚠️ Two clients now exist for the same email; the package is on the wrong one.
#
# What this does:
#   On every successful OAuth callback we search Mindbody for clients with the same email,
#   then call POST /public/v6/client/mergeclients with TargetClientId = the Identity-bound
#   client (kept) and SourceClientId = each duplicate (consumed). Mindbody handles all
#   accounting / visit history / contracts transfer atomically. Idempotent — re-runs find
#   nothing to do.
#
# Latency cost:
#   Adds ~500ms-1.5s to the OAuth callback (1 search + N merge POSTs). Capped at 12s overall;
#   on timeout we log + still issue the cookie + redirect, so sign-in never blocks. The user
#   may briefly see an empty wallet on /classes if the merge timed out — the next sign-in
#   completes the merge.
#
# Accepted values: 1 / true / on (default)  |  0 / false / off (kill-switch).
# Set to 0 to disable WITHOUT a redeploy if Mindbody starts rejecting merges or slowing down.
# STRIPE_AUTO_MERGE_DUPLICATES=1

# ============================================================================
# New-client password-setup email after Stripe checkout (Mindbody API)
# ============================================================================
#
# After a brand-new Mindbody client is created during anonymous Stripe checkout, the webhook
# calls Mindbody POST /client/sendpasswordresetemail (best-effort). Mindbody sends its own
# "Create new password" email using the studio's Password Reset template.
#
# Set to 0 to disable without a redeploy. First sign-in still prompts for a password inline.
# Accepted values: 1 / true / on (default)  |  0 / false / off (kill-switch).
# STRIPE_SEND_NEW_CLIENT_PASSWORD_EMAIL=1

# ─────────────────────────────────────────────────────────────────────────────
# Stripe → Mindbody RECURRING monthly memberships (Option A).
# Stripe handles billing; on every successful invoice.paid the webhook adds the
# matching Mindbody Pricing Option to the client (one Service per renewal). No
# Stripe Customer Portal in V1 — studio handles cancellations / plan changes
# manually through the Stripe Dashboard.
# Full design: docs/MEMBERSHIP-RECURRING-CHECKOUT.md
# Catalog: src/content/stripe-mindbody-catalog.config.json (the 3 monthly_*
# SKUs ship `enabled: false` — flip on the SKU you want to test BEFORE building).

# SERVER-side master kill-switch for the subscription branch in
# `stripe-create-checkout-session.mjs` and the subscription/invoice handlers
# in `stripe-webhook.mjs`. When `0` the server returns
# `stripe_recurring_checkout_disabled` and the webhook ignores subscription
# events. Default `0`. Must be `1` AND the SKU must be `enabled: true` for the
# new flow to fire.
ENABLE_STRIPE_RECURRING_CHECKOUT=0

# BUILD-time master kill-switch for the frontend fork in `pricing-api.js`.
# Read by `scripts/build.mjs` → embedded into `pricing.html` as
# `mb-stripe-recurring-config.enabled`. When `0` the membership purchase click
# always uses the existing Mindbody Classic flow (byte-identical to pre-recurring).
# Both this AND ENABLE_STRIPE_RECURRING_CHECKOUT must be `1` for the new path
# to render, AND the SKU must be `enabled: true` in the catalog AND have a row
# in `byMindbodyServiceId` (auto-derived from the catalog at build time).
ENABLE_STRIPE_RECURRING_CHECKOUT_FRONTEND=0

# Promotion-code field on the Stripe Checkout page for **monthly subscriptions**.
# Default `0`. Separate from ENABLE_STRIPE_PROMOTION_CODES (which controls one-time
# NCS coupons) because Subscription coupon math is its own surface area:
#   • `duration: once`     → first invoice discounted; renewals at full price
#   • `duration: forever`  → every invoice discounted
#   • `duration: repeating` → discount on first N invoices
# The webhook reads each invoice's `total_discount_amounts` independently and forwards
# the per-invoice discount to Mindbody (`Items[0].DiscountAmount`) — no state machine
# on our side. Flip to `1` only after the four-test verification matrix passes:
#   1. No coupon (regression)
#   2. `duration: once` percentage coupon
#   3. `duration: forever` percentage coupon
#   4. Fixed-amount-off coupon
# 100%-off coupons are NOT supported in V1.5 — operationally the studio does not create
# them; code-side `stripe-webhook.mjs::handleInvoicePaid` records a clear
# `coupon_100_percent_off_unsupported` lastError if one slips through.
ENABLE_STRIPE_RECURRING_COUPONS=0

# Hybrid in-webhook retry budget for `invoice.paid` → Mindbody sync.
# Total attempts = 1 + value (default 3 attempts: t0, t0+200ms, t0+1000ms).
# Bounded 0..4. After exhausting the budget the invoice is marked
# `paid_but_not_synced` and surfaces in the admin retry queue.
# STRIPE_INVOICE_PAID_RETRY_BUDGET=2

# Optional override URLs for the membership Checkout Session redirect targets.
# When unset, the function derives them from the request `origin` and embeds
# `subscriptionId={SUBSCRIPTION_ID}` so the success/cancel pages can fetch state.
# STRIPE_SUCCESS_URL_MEMBERSHIP=https://www.amarewellness.com/checkout/success?session_id={CHECKOUT_SESSION_ID}&kind=membership&subscriptionId={SUBSCRIPTION_ID}
# STRIPE_CANCEL_URL_MEMBERSHIP=https://www.amarewellness.com/checkout/cancel?kind=membership&subscriptionId={SUBSCRIPTION_ID}

# LOCAL DEV ONLY — in-memory subscription store fallback for `npm run dev`
# (no Netlify Blobs context). Mirrors STRIPE_ORDER_STORE_LOCAL_MEMORY for the
# subscription store. Hard-disabled when `NETLIFY` is present, so it can never
# activate in a real Netlify deploy. Subscription records live in the dev
# process memory and are lost on restart.
# STRIPE_SUBSCRIPTION_STORE_LOCAL_MEMORY=1

# ─────────────────────────────────────────────────────────────────────────────
# New Client SMS conversion follow-up (daily cron + admin dry-run).
# Full ops guide: docs/NEW-CLIENT-SMS-FOLLOWUP.md
#
# Master switch — when 0/false, scheduled + manual runs log `automation_disabled` and exit.
ENABLE_NEW_CLIENT_SMS_AUTOMATION=0
#
# Default ON: build report only — no Twilio calls, no idempotency writes for sends.
NEW_CLIENT_SMS_DRY_RUN=1
#
# Second gate for live SMS (requires DRY_RUN=0 + Twilio vars below).
ENABLE_NEW_CLIENT_SMS_SENDING=0
#
# Per-segment toggles (Segment C defaults off until A/B validated).
ENABLE_SMS_SEGMENT_ONE_REMAINING=1
ENABLE_SMS_SEGMENT_EXPIRING_SOON=1
ENABLE_SMS_SEGMENT_COMPLETED_NO_PURCHASE=0
# ENABLE_SMS_SEGMENT_CLASSPASS_REPEAT=0
#
NEW_CLIENT_SMS_COUPON_CODE=KEEPMOVING15
NEW_CLIENT_SMS_PRICING_URL=https://www.amarewellness.com/pricing
# NEW_CLIENT_SMS_TIMEZONE=America/New_York
# NEW_CLIENT_SMS_SEED_LOOKBACK_DAYS=45
# Primary seed: Mindbody Reports → Series Expirations → Export XLS (HTML table, not real Excel)
# Place file at: data/mindbody/series-expirations.xls  (see docs/NEW-CLIENT-SMS-FOLLOWUP.md)
# NEW_CLIENT_SMS_SERIES_EXPIRATION_REPORT_PATH=./data/mindbody/series-expirations.xls
# NCS pricing option filter (comma-separated; default "New Client - 3 pack"):
# NEW_CLIENT_SMS_SERIES_EXPIRATION_NCS_NAMES=New Client - 3 pack
# Legacy CSV intro-offers export (optional):
# NEW_CLIENT_SMS_INTRO_OFFERS_CSV_PATH=./data/mindbody/expiring-intro-offers.csv
# Inline CSV (small exports only):
# NEW_CLIENT_SMS_INTRO_OFFERS_CSV=
# Scheduled runs: persist CSV via admin POST + read from Netlify Blobs
# NEW_CLIENT_SMS_INTRO_OFFERS_CSV_FROM_BLOB=0
# Re-enable noisy bulk Mindbody scan even when CSV rows loaded (default off):
# NEW_CLIENT_SMS_ENABLE_MINDBODY_FALLBACK=0
# Hard caps — see docs/NEW-CLIENT-SMS-FOLLOWUP.md §3
# NEW_CLIENT_SMS_DISCOVERY_MAX_CLIENT_PAGES=10
# NEW_CLIENT_SMS_DISCOVERY_MAX_CLASS_SCAN=90
# NEW_CLIENT_SMS_DISCOVERY_MAX_CLIENTS=250
# NEW_CLIENT_SMS_MAX_EVALUATED_CLIENTS=150
# Batched GET /client/clientservices via request.clientIds[] (default 50, hard max 100)
# NEW_CLIENT_SMS_CLIENTSERVICES_BATCH_SIZE=50
# NEW_CLIENT_SMS_COMPLETED_GRACE_DAYS=14
# Optional NCS service ID override (default: catalog newClient IDs, e.g. 100012).
# NEW_CLIENT_SMS_MINDBODY_SERVICE_IDS=100012
# Comma-separated Mindbody client IDs to include (walk-in NCS testing / manual seed).
# NEW_CLIENT_SMS_SEED_CLIENT_IDS=
# NEVER enable in production without legal review — blocks send when Mindbody SMS consent unknown.
# NEW_CLIENT_SMS_ALLOW_UNKNOWN_CONSENT=0
# LOCAL DEV ONLY — in-memory SMS idempotency store (requires NETLIFY unset).
# NEW_CLIENT_SMS_STORE_LOCAL_MEMORY=1
#
# Twilio (required only when DRY_RUN=0 and ENABLE_NEW_CLIENT_SMS_SENDING=1).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
#
# Resend — internal admin dry-run report only (never client marketing email).
ENABLE_NEW_CLIENT_SMS_ADMIN_EMAIL=0
RESEND_API_KEY=
# Bring-a-Friend guest pass blob store (required in production for the feature)
GUEST_PASS_BLOBS=1
# Partner Benefits / Coupons blob store (falls back to GUEST_PASS_BLOBS if unset)
PARTNER_BENEFITS_BLOBS=1
# Local dev only — in-memory blob fallback when Netlify Blobs context is unavailable
# GUEST_PASS_BLOBS_LOCAL_MEMORY=1
# PARTNER_BENEFITS_BLOBS_LOCAL_MEMORY=1
# Local dev only — POST /api/dev/guest-pass/reset to clear failed_manual_review test state
# GUEST_PASS_DEV_RESET=1
# RESEND_FROM=AMARÉ Wellness Studio <info@amarewellness.com>
SMS_ADMIN_REPORT_FROM=AMARÉ Reports <reports@amarewellness.com>
SMS_ADMIN_REPORT_TO=
# Front desk weekly schedule — email assigned staff after Publish (Resend)
# ENABLE_STAFF_SCHEDULE_ADMIN_EMAIL=1
# STAFF_SCHEDULE_EMAIL_FROM=AMARÉ Schedule <schedule@amarewellness.com>
# Admin inbox when staff submit shift availability (defaults to SMS_ADMIN_REPORT_TO)
# STAFF_SCHEDULE_ADMIN_NOTIFY_TO=manager@amarewellness.com
# Optional full URL for the "View update schedule" button (defaults to SITE_URL/classes)
# STAFF_SCHEDULE_CLASSES_URL=https://www.amarewellness.com/classes
# STAFF_SCHEDULE_STORE_LOCAL_MEMORY=1
# Weekly Tuesday auto-email: staff availability request for next week (Netlify scheduled function)
# ENABLE_STAFF_AVAILABILITY_AUTO_REMINDER=1
# Manual test: POST /api/admin/staff-schedule/availability-reminder/run with x-admin-token
# Persists to data/staff-schedule/local-store.json across dev server restarts.
# Combined Follow-Up Dashboard email (New Client + Low Credits). Also accepts ENABLE_NEW_CLIENT_SMS_ADMIN_EMAIL=1.
ENABLE_FOLLOWUP_DASHBOARD_ADMIN_EMAIL=0
# Low Credits tab — max remaining visits on direct packs (default 4)
FOLLOWUP_LOW_CREDITS_MAX_REMAINING=4
# FOLLOWUP_LOW_CREDITS_SERVICE_IDS=100127,100128
# ClassPass Repeat tab — Phase 2 (Client Visits report; separate from Series Expirations)
# FOLLOWUP_CLASSPASS_REPEAT_THRESHOLD=2
# FOLLOWUP_CLASSPASS_LOOKBACK_DAYS=60
# FOLLOWUP_CLIENT_VISITS_REPORT_FROM_BLOB=1
# FOLLOWUP_CLIENT_VISITS_REPORT_PATH=./data/mindbody/client-visits.xls
# Local dev: persist follow-up actions in memory (do not set on Netlify)
# FOLLOWUP_ACTIONS_STORE_LOCAL_MEMORY=1
#
# Manual dry-run: POST /api/admin/new-client-sms/run with header x-admin-token: <ADMIN_DEBUG_TOKEN>
# Admin UI: /admin/new-client-followup and /admin/follow-ups
