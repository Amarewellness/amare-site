# Mindbody Public API (see Developer Portal API Credentials).
# Copy to ".env" and fill in real values — never commit .env.

# Issued under "API Keys" — sent as HTTP header: API-Key
MINDBODY_API_KEY=

# Sandbox studio is typically -99. Your real membership data lives under your live Site ID —
# OAuth can succeed while `/member` stays empty until MINDBODY_SITE_ID matches that studio (-99 often has no prod clients).
# For consumer requests (`consumer-identity-token`), the Functions send MINDBODY_SITE_ID as `SiteId` when it is set and not -99.
MINDBODY_SITE_ID=-99

# Numeric studio id in Mindbody Classic URLs (`clients.mindbodyonline.com/classic/ws?studioid=`).
# `/pricing` reads this at build time; omit to keep build default matching production pricing links.
MINDBODY_CLASSIC_STUDIO_ID=

# `/pricing` — prodid whitelist for memberships that use Mindbody Classic stype=40 (recurring/monthly).
# Default baked into build: 100,101,102 (`pricing.html`). Override with comma list, or `none` for name-only routing.
# MINDBODY_CONTRACT_PRODUCT_IDS=100,101,102
# MINDBODY_SALE_LOCATION_ID=1
# When set to 1/true, `/pricing` will not embed static monthly fallback (only live GET /sale/contracts).
# MINDBODY_DISABLE_MONTHLY_CONTRACT_FALLBACK=1

# Allow real card charges from POST /api/mindbody/sale/checkout when set to exactly 1. Default UX is Mindbody Test (dry-run) until the user confirms a live charge.
# MINDBODY_ALLOW_LIVE_PRICING_CHECKOUT=

# Checkout (`POST …/sale/checkoutshoppingcart`): staff User Token as Authorization Bearer — Consumer OAuth alone is denied.
#
# Recommended (production): dedicated integration staff username/password → server issues a User Token (cached in-memory on warm Netlify instances; `POST /api/mindbody/sale/checkout-warmup` prefetches after sign-in on `/pricing`).
# Same staff token is used for `POST /api/mindbody/client/register` (Add Client on `/classes` sign-up modal) when unified dev or Netlify serve that route.
MINDBODY_STAFF_USERNAME=
MINDBODY_STAFF_PASSWORD=
#
# Disable public profile signup (`POST /api/mindbody/client/register`).
# MINDBODY_DISABLE_CLIENT_SIGNUP=1
#
# Optional; timeout (ms, clamped) for AddClient during signup registration.
# MINDBODY_ADD_CLIENT_TIMEOUT_MS=20000
#
# Optional tuning (ms / sec) — see `mindbody-consumer-lib.mjs` for clamps.
# MINDBODY_ISSUE_TOKEN_TIMEOUT_MS=8000
# MINDBODY_CHECKOUT_TIMEOUT_MS=20000
# If issued token is not a JWT with `exp`, fall back cache TTL (seconds, 60–86400).
# MINDBODY_STAFF_TOKEN_CACHE_TTL_SEC=300
#
# Legacy: paste AccessToken from Issue once — expires.
# MINDBODY_STAFF_USER_TOKEN=

# When set to exactly 1, POST /api/mindbody/sale/checkout records each `purchaseAttemptId` in Netlify Blobs (replay-safe duplicates, 409 while pending). Requires Blobs on the site and a function invocation with `event.blobs`.
# MINDBODY_CHECKOUT_IDEMPOTENCY_BLOBS=

# When set to 1/true, recurring membership checkout stores a structured electronic-consent audit (snapshot HTML hash + typed name + checkboxes + IP/UA + Mindbody IDs) to Netlify Blobs (`mindbody-membership-consents`). Recommended for production if you rely on `/pricing` embedded checkout — requires Blob storage on Functions.
# MINDBODY_MEMBERSHIP_CONSENT_BLOBS=

# Public API Source (same Credentials page).
# Needed for authenticated flows (e.g. staff tokens). Optional for anonymous checks.
MINDBODY_SOURCE_NAME=
MINDBODY_SOURCE_PASSWORD=

# Default production host per docs; override only if Mindbody directs you elsewhere.
MINDBODY_API_HOST=api.mindbodyonline.com

# Mindbody GET proxy (`npm run mindbody:proxy`) — optional if you already use unified `npm run dev`.
# This port serves ONLY /health and GET /api/mindbody/* — no HTML, no /css. Do not point ngrok here for full pages.
MINDBODY_LOCAL_PORT=8787

# Optional: overrides where the browser calls `/api/mindbody/class/classes`, OAuth, member summary, booking.
# Leave EMPTY when using unified local dev (`npm run dev`): same-origin `/api/mindbody/...` → no Netlify, no extra port.
# Production (Netlify): set to your public site URL, e.g. https://www.amarewellness.com — then redeploy so `data-mb-proxy` embeds correctly.
#
# Separate proxy only (`npm run dev:static` + `npm run mindbody:proxy`): http://127.0.0.1:8787 — note OAuth/booking APIs are NOT on 8787; use unified `npm run dev` instead.
#
# Tunneling (ngrok, Cloudflare, etc.) for OAuth: forward to unified dev (`npm run dev`) on LOCAL_FULL_DEV_PORT (default 4321),
# NOT to MINDBODY_LOCAL_PORT (8787). Otherwise `/pricing` HTML may appear from cache while `/css/*.css` hits a server that returns 404.
#
# LOCAL_FULL_DEV_HOST=0.0.0.0
# LOCAL_FULL_DEV_PORT=4321
SCHEDULE_PROXY_BASE=

# Optional: per-class "Book" link template (HTTPS URL). Substitutions below.
# Booking via API normally uses POST …/class/addclienttoclass with a client JWT — Mindbody docs.
# Alternative: branded booking URL patterns from Mindbody support / custom-online-booking-links.
# Placeholders:
# {siteId} {classId} {classScheduleId} {locationId} {startDateEt} yyyy-mm-dd ET {startISO} URL-encoded
MINDBODY_BOOK_URL_TEMPLATE=

# When template is empty, Book opens this page relative to site root (widget).
MINDBODY_BOOK_FALLBACK_REL=classes.html

# Optional: “New client / Sign up” link in Book modal (HTTPS). When empty, the modal uses MINDBODY_BOOK_FALLBACK_REL (Mindbody widget) for onboarding.
MINDBODY_CONSUMER_SIGNUP_URL=

# ─── OPTIONAL: OAuth "consumer / web app" flow (sign-in UX on /classes).
# Mindbody Public API tutorials that use API-Key/Source do NOT grant these IDs.
# Omit this whole block if you only use the schedule proxy + MINDBODY_API_KEY.
# When needed: Mindbody Developer Portal → create/register a separate OAuth / Web application
# for your site; CLIENT_ID & CLIENT_SECRET come from that app — not from the API Credentials screen.
# Redirect URI MUST match the Mindbody client exactly — same scheme, host, port, path, no trailing slash.
# Mindbody’s portal rejects typical local URLs (http://127.0.0.1 / http://localhost). You get signin „invalid-parameters”.
# Practical options:
#   • HTTPS production or Netlify Deploy Preview URL + path /api/mindbody/oauth/callback
#   • HTTPS tunnel to this machine (ngrok / cloudflared): register the tunnel https://…/api/mindbody/oauth/callback
#     then open the site ONLY via that same https://… URL (cookie is scoped to that host, not http://127.0.0.1).
MINDBODY_OAUTH_CLIENT_ID=
MINDBODY_OAUTH_CLIENT_SECRET=
MINDBODY_OAUTH_REDIRECT_URI=https://www.example.com/api/mindbody/oauth/callback
MINDBODY_OAUTH_ISSUER=https://signin.mindbodyonline.com
MINDBODY_OAUTH_SCOPES=email profile openid offline_access Mindbody.Api.Public.v6
# Optional; sent to authorize + token if your OAuth app uses a fixed subscriber (often same as site / from Mindbody support).
# MINDBODY_OAUTH_SUBSCRIBER_ID=
#
# Random secret (≥24 chars); only used when OAuth sign-in is enabled — seals the HttpOnly mb_sess cookie on the server.
# Unified `npm run dev` exits on startup if this is empty (OAuth/member routes need it).
MINDBODY_SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Stripe → Mindbody one-time checkout (NCS / drop-in / 5–10–20 class packs).
# Recurring memberships are NOT routed through Stripe — they stay on Mindbody classic.
# Catalog mapping lives in `netlify/functions/_embedded/stripe-mindbody-catalog.config.json`.
# Flow + decisions: `docs/STRIPE-MINDBODY-QUESTIONS.md`.

# Master kill-switch. When `1`, `/api/stripe/checkout/create-session` accepts requests and
# the express-checkout CTA renders on /pricing for SKUs flagged `enabledForExpressCheckout`.
# Default `0` so existing Mindbody classic flow is unchanged until you flip this.
ENABLE_STRIPE_ONE_TIME_CHECKOUT=0

# Stripe API keys. Use the test keys (`sk_test_…` / `pk_test_…`) until production rollout.
# Never expose `STRIPE_SECRET_KEY` to the browser; only `STRIPE_PUBLISHABLE_KEY` is safe to embed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret from your Stripe Dashboard → Developers → Webhooks endpoint.
# `stripe-webhook.mjs` rejects requests whose signature does not verify under this secret.
STRIPE_WEBHOOK_SECRET=

# Optional return URLs override (defaults are derived from the request `origin`).
# STRIPE_SUCCESS_URL=https://www.amarewellness.com/checkout/success?session_id={CHECKOUT_SESSION_ID}&orderId={ORDER_ID}
# STRIPE_CANCEL_URL=https://www.amarewellness.com/checkout/cancel?orderId={ORDER_ID}

# How the post-Stripe Mindbody sync books the sale.
#  • `custom`  — recommended. Use the Mindbody Payment Method named in MINDBODY_STRIPE_PAYMENT_METHOD_NAME (default "Stripe").
#                Requires that payment method to exist + Allow >$0 + PayNotes enabled.
#  • `comp`    — fallback / dev only. Books the line as `Comp` ($0) with notes referencing the Stripe order.
#                Will under-report Mindbody revenue; do not use in production unless you accept that.
# If `custom` is selected and Mindbody rejects the payment method on a live sync, the order is parked at
# `paid_but_not_synced` for manual review — we do NOT silently downgrade to comp.
MINDBODY_STRIPE_PAYMENT_MODE=custom

# Display name of the custom Mindbody Payment Method. Match exactly what was created in Mindbody
# (Site Settings → Payment Methods). Default: `Stripe`.
MINDBODY_STRIPE_PAYMENT_METHOD_NAME=Stripe

# Numeric Mindbody Payment Method id for the custom `Stripe` row.
# REQUIRED when MINDBODY_STRIPE_PAYMENT_MODE=custom — Mindbody rejects `Type:"Custom"` Payments
# without `Metadata.id` ("The received Custom's Metadata was missing key id.").
# Discover with: `npm run stripe:find-mb-payment-id`
# (calls GET /public/v6/sale/custompaymentmethods and prints id+name pairs).
MINDBODY_STRIPE_PAYMENT_METHOD_ID=

# Optional: protected token for `/api/stripe/admin/orders` (list / retry / mark resolved).
# Generate with `openssl rand -hex 24`. Endpoint requires header `x-admin-token: <value>`.
# ADMIN_DEBUG_TOKEN=

# Site URL fallback used by `/api/stripe/checkout/create-session` to build success/cancel URLs
# when the inbound request does not provide an `origin`. Optional.
# SITE_URL=https://www.amarewellness.com

# LOCAL DEV ONLY: in-memory order store fallback for `npm run dev` (no Netlify Blobs context).
# Set to `1` only on a developer machine. Hard-disabled when `NETLIFY` env var is present, so it
# can never activate in a real Netlify deploy. Order data lives in the dev process memory and is
# lost on restart. Real deploys must use Netlify Blobs.
# STRIPE_ORDER_STORE_LOCAL_MEMORY=1

# SAFETY GATE between Stripe test mode and the Mindbody sync.
#
# Stripe `event.livemode === false` (test card / test secret key) → behavior depends on this var.
# Stripe `event.livemode === true`  (live card)                    → ALWAYS syncs to Mindbody live, regardless of this var.
#
# Allowed values:
#  • `skip`           — DEFAULT. Stripe test events never touch Mindbody. The order is recorded
#                       with status `test_mode_no_sync` for accounting. Stripe gets 200 so it
#                       stops retrying. Use this in production: a leaked test card cannot create
#                       a real Mindbody client or service.
#  • `mindbody_test`  — Pipeline rehearsal. Webhook still calls Mindbody, but with the Mindbody
#                       `Test: true` flag — Mindbody validates the request without persisting a
#                       real client / service. Useful for dev / staging to exercise the full sync
#                       path end-to-end.
#  • `live`           — DANGEROUS. Stripe test events are synced to Mindbody as if they were
#                       live. Do not use against your production Mindbody site. Acceptable only
#                       for staging environments pointing at a sandbox Mindbody site (-99) where
#                       you want to see real records get created.
#
# Default if unset: `skip`.
# STRIPE_TEST_MODE_MINDBODY_BEHAVIOR=skip

# Stripe Checkout — Contact information prefill from Mindbody (logged-in members).
#
# When ON, `stripe-create-checkout-session.mjs` looks up the buyer's Mindbody profile
# (clientId by email if needed → email/name/phone) and binds it to a Stripe Customer so
# Stripe-hosted Checkout shows their email/name/phone already filled in. Adds 1–2 extra
# Mindbody round-trips + 1–2 Stripe API calls before the redirect (each capped by
# `STRIPE_CHECKOUT_PREFILL_TIMEOUT_MS`).
#
# Anonymous buyers are unaffected (no extra calls).
#
# Set to 0 to disable WITHOUT a redeploy if Mindbody latency hurts checkout. Anonymous
# fallback still works — checkout never blocks, members just have to retype.
#
# Accepted values: 1 / true / on (default)  |  0 / false / off (kill-switch).
# STRIPE_CHECKOUT_PREFILL_FROM_MINDBODY=1

# Hard timeout (ms) per Mindbody call inside the prefill flow above. If Mindbody is slower
# than this for clientId-by-email or contact lookup, we silently fall back to anonymous
# checkout (the customer never waits longer than this for prefill).
#
# Bounded between 2000 and 10000. Default 5000.
# STRIPE_CHECKOUT_PREFILL_TIMEOUT_MS=5000
