# Mindbody Public API (see Developer Portal API Credentials).
# Copy to ".env" and fill in real values — never commit .env.

# Issued under "API Keys" — sent as HTTP header: API-Key
MINDBODY_API_KEY=

# Sandbox studio is typically -99; use your live Site ID once activated.
MINDBODY_SITE_ID=-99

# Public API Source (same Credentials page).
# Needed for authenticated flows (e.g. staff tokens). Optional for anonymous checks.
MINDBODY_SOURCE_NAME=
MINDBODY_SOURCE_PASSWORD=

# Default production host per docs; override only if Mindbody directs you elsewhere.
MINDBODY_API_HOST=api.mindbodyonline.com

# Local proxy (scripts/local-api-server.mjs).
MINDBODY_LOCAL_PORT=8787

# Injected into classes-api.html for browser → proxy (no secrets).
# Built site reads .env via scripts/build.mjs when you build locally.
SCHEDULE_PROXY_BASE=http://127.0.0.1:8787

# Optional: per-class "Book" link template (HTTPS URL). Substitutions below.
# Booking via API normally uses POST …/class/addclienttoclass with a client JWT — Mindbody docs.
# Alternative: branded booking URL patterns from Mindbody support / custom-online-booking-links.
# Placeholders:
# {siteId} {classId} {classScheduleId} {locationId} {startDateEt} yyyy-mm-dd ET {startISO} URL-encoded
MINDBODY_BOOK_URL_TEMPLATE=

# When template is empty, Book opens this page relative to site root (widget).
MINDBODY_BOOK_FALLBACK_REL=classes.html
